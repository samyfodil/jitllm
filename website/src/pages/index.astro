    <script is:inline src={`${base}/numbers.js`}></script>
      <script is:inline>
      // The desktop screenshots' tabs.
      for (const root of document.querySelectorAll('[data-shots]')) {
        const tabs = [...root.querySelectorAll('[role="tab"]')]
        const show = (t) => tabs.forEach((o) => {
          o.setAttribute('aria-selected', String(o === t))
          document.getElementById(o.getAttribute('aria-controls')).hidden = o !== t
        })
        tabs.forEach((t) => t.addEventListener('click', () => show(t)))
      }
    </script>
