---
// The pixel wordmark, banded crest to dim, drawn at build time from the same
// rectangles as the landing page's WORD_RECTS (public/app.js).
const W = 53
const H = 21
const RECTS = [
  [3, 0, 3, 3], [3, 5, 3, 15], [0, 18, 5, 3], [9, 0, 3, 3], [9, 5, 3, 12],
  [17, 1, 3, 16], [15, 5, 8, 3], [20, 14, 3, 3], [26, 0, 3, 17], [32, 0, 3, 17],
  [38, 5, 14, 3], [38, 5, 3, 12], [44, 5, 3, 12], [50, 6, 3, 11],
]
const BANDS = [['crest', 5], ['hover', 3], ['lit', 5], ['mid', 4], ['dim', 4]]
const bandOf = (row) => {
  let at = row
  for (const [name, n] of BANDS) {
    if (at < n) return name
    at -= n
  }
  return 'dim'
}
const on = Array.from({ length: H }, () => Array(W).fill(false))
for (const [x, y, w, h] of RECTS) for (let r = y; r < y + h; r++) for (let c = x; c < x + w; c++) on[r][c] = true
// One rectangle per horizontal run, so each carries its row's band.
const runs = []
on.forEach((row, y) => {
  for (let x = 0; x < W; x++) {
    if (!row[x]) continue
    let n = 1
    while (row[x + n]) n++
    runs.push({ x, y, n, band: bandOf(y) })
    x += n - 1
  }
})
---
<svg class="wordmark" viewBox={`0 0 ${W} ${H}`} shape-rendering="crispEdges" aria-hidden="true">
  {runs.map(({ x, y, n, band }) => <rect x={x} y={y} width={n} height="1" style={`fill:var(--f-${band})`} />)}
</svg>
